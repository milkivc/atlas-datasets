  "//": "========================================================================",
  "//": "Configurações de Repositórios",
  "//": "========================================================================",

  "repositories": {
    "default_branch": "main",
    "license": "EUPL-1.2",
    "visibility": "public",
    "topics": [
      "patrimonio-cultural",
      "dados-geospaciais",
      "interoperabilidade",
      "preservacao-digital",
      "Portugal",
      "Associacao-MILK",
      "Atlas-Vivo",
      "RGPD",
      "AI-Act",
      "FAIR-Principles",
      "EUPL-1.2",
      "Codeberg",
      "Forgejo"
    ]
  },

  "//": "========================================================================",
  "//": "Configurações de Metadados",
  "//": "========================================================================",

  "metadata": {
    "default_author": {
      "name": "Nuno Filipe Fernandes Vieira Cabral e Araujo",
      "email": "nuno@associacaomilk.pt",
      "orcid": "https://orcid.org/0009-0009-1781-4020",
      "affiliation": "Associacao MILK"
    },
    "co_authors": [
      {
        "name": "Eduardo Mauricio Vieira Cabral e Araujo",
        "email": "eduardo@associacaomilk.pt",
        "orcid": "https://orcid.org/0009-0007-6892-6570",
        "affiliation": "Associacao MILK"
      }
    ],
    "license": "EUPL-1.2",
    "license_url": "https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12",
    "keywords": [
      "patrimonio cultural",
      "dados geospaciais",
      "interoperabilidade",
      "preservacao digital",
      "Portugal",
      "Associacao MILK",
      "Atlas Vivo",
