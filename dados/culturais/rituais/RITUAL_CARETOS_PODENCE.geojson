      "properties": {
        "id": "RITUAL_CARETOS_PODENCE_2026",
        "name": "Ritual dos Caretos",
        "name_en": "Careto Ritual",
        "description": "Ritual tradicional de Inverno em Podence, Trás-os-Montes, onde homens vestidos com máscaras de madeira e trajes coloridos (Caretos) percorrem a aldeia em grupo, tocando chocalhos e tambores. O ritual tem origem pré-cristã e está associado à fertilidade e à expulsão dos maus espíritos.",
        "description_en": "Traditional Winter ritual in Podence, Trás-os-Montes, where men dressed in wooden masks and colorful costumes (Caretos) parade through the village in groups, playing rattles and drums. The ritual has pre-Christian origins and is associated with fertility and the expulsion of evil spirits.",
        "type": "Ritual",
        "subtype": "Festa de Inverno",
        "region": "Trás-os-Montes",
        "municipality": "Macedo de Cavaleiros",
        "parish": "Podence",
        "country": "Portugal",
        "coordinates": {
          "latitude": 41.3426,
          "longitude": -7.2266,
          "altitude": 720
        },
        "date": {
          "start": "2026-02-01",
          "end": "2026-02-28",
          "frequency": "Anual"
        },
        "participants": {
          "total": 50,
          "male": 35,
          "female": 15,
          "age_range": {
            "min": 18,
            "max": 80,
            "average": 45
          }
        },
        "tradition": {
          "origin": "Pré-cristã (possivelmente celta ou ibérica)",
          "history": "O Ritual dos Caretos é uma das tradições mais antigas de Portugal, com registos que remontam ao século XVI. Em 2019, foi classificado como Património Cultural Imaterial de Interesse Nacional.",
          "symbolism": [
            "Fertilidade",
            "Expulsão de maus espíritos",
            "Renovação da natureza",
            "Celebração do solstício de Inverno"
          ],
          "elements": {
            "masks": {
              "material": "Madeira (carvalho ou castanheiro)",
              "colors": ["Vermelho", "Preto", "Amarelo", "Verde"],
              "symbolism": "Cada cor representa um elemento da natureza (fogo, terra, sol, vegetação)."
            },
            "costumes": {
              "material": "Lã, linho, algodão",
              "colors": ["Vermelho", "Azul", "Amarelo", "Verde"],
              "accessories": ["Chocalhos", "Tambores", "Cintos de sinos"]
            },
            "music": {
              "instruments": ["Chocalhos", "Tambores", "Gaitas"],
              "rhythm": "Binário (2/4)",
              "melody": "Tradicional (transmitida oralmente)"
            }
          },
          "steps": [
            {
              "step": 1,
              "name": "Preparação",
              "description": "Os Caretos preparam as máscaras e trajes durante o mês de Janeiro."
            },
            {
              "step": 2,
              "name": "Bênção",
              "description": "As máscaras são benzidas pelo padre local na véspera do ritual."
            },
            {
              "step": 3,
              "name": "Saída dos Caretos",
              "description": "Os Caretos saem de casa em casa, tocando os chocalhos e cantando."
            },
            {
              "step": 4,
              "name": "Perseguição",
              "description": "Os Caretos perseguem as mulheres solteiras da aldeia (simbólicamente)."
            },
            {
              "step": 5,
              "name": "Fim do Ritual",
              "description": "Os Caretos reúnem-se na praça principal para uma dança final."
            }
          ]
        },
        "status": {
          "current": "Ativo",
          "risk": "Baixo",
