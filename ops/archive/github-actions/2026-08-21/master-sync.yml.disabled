name: ATLAS VIVO - Master Sync

on:
  push:
    branches: [ master, main ]
  workflow_dispatch:

jobs:
  sync-all:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'
      
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests pyyaml jq
      
      - name: Execute Full Sync
        run: |
          python3 agent-integration/scripts/sync-all-platforms.py --verbose
      
      - name: Check Funding Compliance
        run: |
          python3 agent-integration/scripts/funding-checker.py report
        env:
          ZENODO_TOKEN: ${{ secrets.ZENODO_TOKEN }}
          ORCID_TOKEN: ${{ secrets.ORCID_TOKEN }}
          CODEBERG_TOKEN: ${{ secrets.CODEBERG_TOKEN }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
